# POP RUSH - Shared Firebase Family Leaderboard Configuration
# Copy this file to .env and fill in your Firebase project values.
# See FIREBASE_SETUP.md for complete step-by-step console instructions.

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=your-game-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-game-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-game-project
VITE_FIREBASE_STORAGE_BUCKET=your-game-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
